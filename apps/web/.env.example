# Everything prefixed VITE_ ships to the browser. Never put secrets here;
# the build refuses variables whose names look like keys or passwords.

VITE_API_URL=http://localhost:3000
VITE_APP_URL=http://localhost:5173
# Comma-separated. Must be a subset of the API's ENABLED_NETWORKS.
VITE_ENABLED_NETWORKS=bsc-testnet,solana-devnet

# Optional: WalletConnect / Reown project id (32 hex characters).
VITE_REOWN_PROJECT_ID=

# Optional: browser RPC endpoints. Use domain-restricted keys only.
VITE_BSC_MAINNET_RPC_URL=
VITE_BSC_TESTNET_RPC_URL=
VITE_SOLANA_MAINNET_RPC_URL=
VITE_SOLANA_DEVNET_RPC_URL=
