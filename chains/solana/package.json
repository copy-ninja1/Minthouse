{
  "name": "@minthouse/chain-solana",
  "version": "0.1.0",
  "private": true,
  "description": "Operator scripts for standard SPL tokens with Metaplex metadata. Uses the same builders as the web app.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint scripts",
    "deploy:local": "tsx scripts/deploy.ts --cluster=localnet",
    "deploy:devnet": "tsx scripts/deploy.ts --cluster=devnet",
    "deploy:mainnet": "tsx scripts/deploy.ts --cluster=mainnet-beta",
    "inspect": "tsx scripts/inspect.ts",
    "supply": "tsx scripts/supply.ts",
    "balance": "tsx scripts/balance.ts",
    "mint": "tsx scripts/mint.ts",
    "transfer": "tsx scripts/transfer.ts",
    "burn": "tsx scripts/burn.ts",
    "authority:transfer": "tsx scripts/set-mint-authority.ts",
    "authority:revoke": "tsx scripts/revoke-mint-authority.ts",
    "airdrop": "tsx scripts/airdrop.ts",
    "pump:inspect": "tsx scripts/pump-inspect.ts",
    "pump:launch": "tsx scripts/pump-launch.ts",
    "pump:buy": "tsx scripts/pump-trade.ts --buy",
    "pump:sell": "tsx scripts/pump-trade.ts --sell"
  },
  "dependencies": {
    "@minthouse/blockchain": "workspace:*",
    "@minthouse/config": "workspace:*",
    "@minthouse/shared": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "zod": "4.6.7"
  }
}
