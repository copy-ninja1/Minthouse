{
  "name": "@minthouse/chain-bsc",
  "version": "0.1.0",
  "private": true,
  "description": "LaunchpadToken ERC-20 contract, tests, and operator scripts for BNB Smart Chain.",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "export": "hardhat compile && tsx scripts/export-artifacts.ts",
    "export:check": "hardhat compile && tsx scripts/export-artifacts.ts --check",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "typecheck": "hardhat compile && tsc --noEmit",
    "lint": "eslint scripts test hardhat.config.ts",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network bsc",
    "verify:testnet": "hardhat run scripts/verify.ts --network bscTestnet",
    "verify:mainnet": "hardhat run scripts/verify.ts --network bsc",
    "run:script": "hardhat run"
  },
  "dependencies": {
    "@minthouse/blockchain": "workspace:*",
    "@minthouse/config": "workspace:*",
    "@minthouse/shared": "workspace:*",
    "@openzeppelin/contracts": "5.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@nomicfoundation/hardhat-verify": "3.1.4",
    "hardhat": "3.21.0",
    "viem": "2.57.11"
  }
}
